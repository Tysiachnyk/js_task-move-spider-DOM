'use strict';
var wall = document.querySelector('.wall');
var spider = document.querySelector('.spider');
document.addEventListener('click', function(e) {
    if (!wall.contains(e.target)) return;
    var wallRect = wall.getBoundingClientRect();
    var leftPosition = e.clientX - wallRect.left - wall.clientLeft - spider.offsetWidth / 2;
    var topPosition = e.clientY - wallRect.top - wall.clientTop - spider.offsetHeight / 2;
    var maxLeft = wall.clientWidth - spider.offsetWidth;
    var maxTop = wall.clientHeight - spider.offsetHeight;
    spider.style.left = "".concat(Math.min(Math.max(leftPosition, 0), maxLeft), "px");
    spider.style.top = "".concat(Math.min(Math.max(topPosition, 0), maxTop), "px");
});

